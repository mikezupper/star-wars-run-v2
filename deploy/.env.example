# Copy to .env on the server (next to compose.yml). .env is never committed.

# Images: your registry path and the tag to run (the commit `pnpm docker:build` printed).
# The API's image is the same path with -api on the end.
STARWARS_IMAGE=ghcr.io/you/starwars-run
STARWARS_TAG=latest

# Where the data is (pages.sqlite, archive.duckdb, ask-schema.json from `pnpm build`'s dist-api/):
# a dated host folder (switch and roll back by changing this line), or a Docker volume's name.
# Unset, it's the named volume starwars-run_data. See docs/deploy.md, "The data".
STARWARS_DATA=/srv/starwars-run/data/2026-10-09

# The host name Traefik routes to the site.
STARWARS_HOST=starwars.run

# Your Traefik setup (defaults shown; the same as sabacc's).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Ask's model: an OpenAI-compatible endpoint (ADR 0009). Only the api container gets these.
ASK_ORIGIN=https://openai.example.com
ASK_KEY=
ASK_MODEL=Qwen3.8-27B

# Question-log backups kept by backup.sh (default shown).
KEEP_BACKUPS=14
