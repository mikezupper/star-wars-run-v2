{
  "name": "starwars.run",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mike Zupper",
  "description": "starwars.run: a Star Wars content site with search, detail pages and cross-links, built with Gyral.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && tsx scripts/build.ts",
    "preview": "tsx scripts/preview.ts",
    "ingest": "tsx scripts/ingest.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm invariants && pnpm test && pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "invariants": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@gyral/core": "^0.1.0",
    "@gyral/ssr": "^0.1.0",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gyral/testing": "^0.1.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-compat": "7.0.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-plugin-use-baseline": "1.4.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "valibot": "1.5.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
